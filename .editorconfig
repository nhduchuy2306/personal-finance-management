# EditorConfig — https://editorconfig.org
# Top-most EditorConfig file
root = true

# ──────────────────────────────────────────────
# Default settings for all files
# ──────────────────────────────────────────────
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

# ──────────────────────────────────────────────
# Java source files — 2-space indent
# ──────────────────────────────────────────────
[*.java]
indent_size = 2
max_line_length = 120

# ──────────────────────────────────────────────
# Gradle build files (Groovy DSL) — 4-space indent
# ──────────────────────────────────────────────
[*.gradle]
indent_size = 4

# ──────────────────────────────────────────────
# Gradle Kotlin DSL
# ──────────────────────────────────────────────
[*.gradle.kts]
indent_size = 4

# ──────────────────────────────────────────────
# YAML config — 2-space indent (Spring Boot, Docker Compose)
# ──────────────────────────────────────────────
[*.{yml,yaml}]
indent_size = 2

# ──────────────────────────────────────────────
# Properties files
# ──────────────────────────────────────────────
[*.properties]
indent_size = 2

# ──────────────────────────────────────────────
# SQL migrations (Flyway) — 4-space indent
# ──────────────────────────────────────────────
[*.sql]
indent_size = 4

# ──────────────────────────────────────────────
# Protobuf (gRPC) — 2-space indent
# ──────────────────────────────────────────────
[*.proto]
indent_size = 2

# ──────────────────────────────────────────────
# XML (Maven POM, Spring XML, etc.)
# ──────────────────────────────────────────────
[*.xml]
indent_size = 4

# ──────────────────────────────────────────────
# JSON
# ──────────────────────────────────────────────
[*.json]
indent_size = 2

# ──────────────────────────────────────────────
# TOML (Gradle version catalog)
# ──────────────────────────────────────────────
[*.toml]
indent_size = 2

# ──────────────────────────────────────────────
# Markdown documentation
# ──────────────────────────────────────────────
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# ──────────────────────────────────────────────
# Shell scripts (gradlew, etc.)
# ──────────────────────────────────────────────
[*.{sh,bash}]
indent_size = 4
end_of_line = lf

# ──────────────────────────────────────────────
# Windows batch scripts
# ──────────────────────────────────────────────
[*.{bat,cmd}]
indent_size = 4
end_of_line = crlf

# ──────────────────────────────────────────────
# Dockerfile
# ──────────────────────────────────────────────
[Dockerfile*]
indent_size = 2

# ──────────────────────────────────────────────
# Git & CI config
# ──────────────────────────────────────────────
[.gitignore]
insert_final_newline = true

[.editorconfig]
insert_final_newline = true

# ──────────────────────────────────────────────
# Generated files — do NOT reformat
# ──────────────────────────────────────────────
[**/build/**]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false

[**/generated/**]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false

[gradlew]
end_of_line = lf

[gradlew.bat]
end_of_line = crlf
